digraph blast_radius_module_core_model {
  rankdir=RL;
  label="Blast radius: module:core-model (src/core)\narchitecture_impact direction=both maxDepth=4 — 11 nodes / 34 edges visited, truncated at max_depth\n实线=confirmed，虚线=inferred；这是模型可达性，不是运行时故障预测";
  labelloc="t";
  fontname="Segoe UI";
  fontsize=12;
  node [shape=box, fontname="Segoe UI", fontsize=10];
  edge [fontname="Segoe UI", fontsize=9];

  target [label="module:core-model\nsrc/core 纯函数核心\n(目标)", shape=box, style="filled,bold", fillcolor="#fed7d7"];

  // 上游：直接依赖 core 的三个实现模块 + 入口 + 测试
  subgraph cluster_upstream_direct {
    label="上游 depth=1（直接依赖，全部 confirmed）";
    style="rounded";
    color="#2b6cb0";
    u_entry [label="container:plugin-entry"];
    u_collectors [label="module:collectors"];
    u_host [label="module:host-adapters"];
    u_tests [label="module:tests"];
  }

  // 上游 depth=2..4：经由上游节点继续反向可达
  subgraph cluster_upstream_transitive {
    label="上游 depth=2..4（传递可达）";
    style="rounded,dashed";
    color="#2b6cb0";
    u_agent [label="actor:agent\n(inferred)", style="dashed,filled", fillcolor="#fffaf0"];
    u_host_ext [label="external:pi-desktop-host"];
    u_model [label="datastore:target-model\n(inferred)", style="dashed,filled", fillcolor="#fffaf0"];
    u_panel [label="container:panel"];
    u_contract [label="module:contract"];
    u_skills [label="module:skills"];
    u_extension [label="container:agent-extension"];
    u_developer [label="actor:developer\n(low confidence)", style="dashed,filled", fillcolor="#fffaf0"];
  }

  // 下游：core 在模型中没有出边——它是汇点，什么都不依赖
  downstream_none [label="下游（core 依赖什么）= 空\nsrc/core 在模型中没有任何出边，\n因此改 core 不会向上游传导，只会被上游传导", shape=note, style="filled", fillcolor="#f0fff4"];

  u_entry -> target [label="depends_on (confirmed)", style=solid];
  u_collectors -> target [label="depends_on (confirmed)", style=solid];
  u_host -> target [label="depends_on (confirmed)", style=solid];
  u_tests -> target [label="depends_on (confirmed)", style=solid];

  u_host_ext -> u_entry [label="depends_on (confirmed)", style=solid];
  u_agent -> u_host [label="calls (inferred)", style=dashed];
  u_collectors -> u_model [label="reads (inferred)", style=dashed];
  u_panel -> u_host_ext [label="calls (confirmed)", style=solid];
  u_host_ext -> u_contract [label="reads (inferred)", style=dashed];
  u_agent -> u_skills [label="subscribes (inferred)", style=dashed];
  u_extension -> u_skills [label="depends_on (inferred)", style=dashed];
  u_developer -> u_panel [label="calls (low confidence)", style=dashed];

  target -> downstream_none [style=invis];

  // 遍历停止原因必须画进图里，否则读者会把截断当成"没有更多"
  stop [label="stopReasons: max_depth\nmaxDepth=4 到达；最深层前沿有 3 条边未展开\ntruncated=true — 不等于“没有更多受影响节点”", shape=note, style="filled", fillcolor="#fffaf0"];
  u_developer -> stop [style=invis];
}
